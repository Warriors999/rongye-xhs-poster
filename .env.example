# AI provider selection: mock or openai-compatible
AI_PROVIDER=mock

# Gemini 使用 Google 原生协议；OpenAI 图像模型使用 /v1 兼容协议
AI_VISION_PROTOCOL=google
AI_VISION_BASE_URL=https://your-relay.example
AI_IMAGE_BASE_URL=https://your-relay.example/v1

# 兼容旧版 OpenAI Provider 的公共地址
AI_BASE_URL=https://your-relay.example/v1

# 两个模型分别使用的密钥，仅服务端读取，不要加 NEXT_PUBLIC_ 前缀
AI_VISION_API_KEY=
AI_IMAGE_API_KEY=

# 兼容旧配置：如果只使用一个密钥，也可以填写这里
AI_API_KEY=

# 视觉/文字模型：需要支持图片输入和结构化 JSON 输出
AI_VISION_MODEL=

# 图像编辑/生图模型：需要支持 image-to-image 或 image editing
AI_IMAGE_MODEL=

# 可选：设置后，网站使用浏览器访问密码保护；不设置则不启用
APP_ACCESS_PASSWORD=
