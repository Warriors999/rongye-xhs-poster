# 绒页当前主流程：上传真实针织玩偶和想法，生成三个动态方向的完整微海报后直接下载。
# mock 不需要密钥，适合本地体验和 E2E，不会访问外部研究或图片 API，也不会产生 API 费用。

# AI provider selection: mock or openai-compatible
AI_PROVIDER=mock

# 视觉/文字模型协议。google 表示使用 Gemini 原生协议；留空时可使用兼容协议
AI_VISION_PROTOCOL=google
# 视觉/文字模型地址（例如 Gemini 中转站地址）
AI_VISION_BASE_URL=https://your-relay.example
# 图片模型地址（例如 OpenAI-compatible 中转站的 /v1 地址）
AI_IMAGE_BASE_URL=https://your-relay.example/v1

# 兼容旧版 OpenAI Provider 的公共地址；新配置优先分别填写上面的两个地址
AI_BASE_URL=https://your-relay.example/v1

# 两个模型可以共用一个第三方中转站，但分别配置 key；仅服务端读取，不要加 NEXT_PUBLIC_ 前缀
AI_VISION_API_KEY=
AI_IMAGE_API_KEY=

# 兼容旧配置：如果只使用一个密钥，也可以填写这里作为回退
AI_API_KEY=

# 视觉/文字模型：需要支持图片输入和结构化 JSON 输出
AI_VISION_MODEL=

# 图片模型：用于生成保留真实玩偶的完整微海报
AI_IMAGE_MODEL=
AI_IMAGE_SIZE=1152x1536

# 可选：参考研究服务。服务端会以 POST JSON { query, limit: 3, platform: 'pinterest' } 调用
# 未配置、超时或返回异常时使用内置设计规则 fallback，不影响生成流程；API key 只在服务端使用
REFERENCE_RESEARCH_URL=
REFERENCE_RESEARCH_API_KEY=

# 异步任务生产配置：本地留空使用内存 task store、queue、storage；线上同时配置 Redis 和 R2
REDIS_URL=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 结果默认走 /api/tasks/{taskId}?asset=... 的私有代理，不需要公开桶；如未来使用 CDN 再填写
R2_PUBLIC_BASE_URL=

# 可选：设置后，网站使用浏览器访问密码保护；不设置则不启用
APP_ACCESS_PASSWORD=
